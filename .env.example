# Plantilla de desarrollo local. T-01 todavía no carga variables de entorno.
# Las variables de servicios se añadirán al implementar sus tareas aprobadas.
NODE_ENV=development

# Mínimo 32 bytes aleatorios; nunca versionar el secreto real.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_32_BYTES_OR_MORE
