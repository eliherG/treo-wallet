  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "description": "Identificador opcional; el servidor garantiza uno nuevo/verificado.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "UUID recomendado; única por usuario y payload inmutable.",
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      },
      "TransferId": {
        "name": "transferId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Cursor opaco HMAC ligado al usuario y filtros."
      },
      "FromDate": {
        "name": "from",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "Día inicial inclusivo en America/Mexico_City."
      },
      "ToDate": {
        "name": "to",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "Día final inclusivo en America/Mexico_City."
      },
      "TypeFilter": {
        "name": "type",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "DEBIT",
            "CREDIT"
          ]
        }
      },
      "AccountFilter": {
        "name": "accountId",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "type",
          "title",
          "status",
          "requestId",
          "code"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false,
        "required": [
          "user"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          },
          "client": {
            "type": "string",
            "enum": [
              "WEB",
              "MOBILE"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "client"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresInSeconds": {
            "type": "integer",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Solo clientes MOBILE; en WEB se usa cookie HttpOnly."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false,
        "required": [
          "accessToken",
          "accessExpiresInSeconds",
          "user"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string",
            "enum": [
              "WEB",
              "MOBILE"
            ]
          },
          "refreshToken": {
            "type": "string",
            "description": "Obligatorio en MOBILE; WEB presenta cookie segura."
          }
        },
        "additionalProperties": false,
        "required": [
          "client"
        ]
      },
      "LogoutResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          }
        },
        "additionalProperties": false,
        "required": [
          "success"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clabeMasked": {
            "type": "string",
            "example": "**************1234"
          },
          "currency": {
            "type": "string",
            "const": "MXN"
          },
          "balanceCents": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Valor exacto en centavos; no usar float."
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "BLOCKED"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "clabeMasked",
          "currency",
          "balanceCents",
          "status"
        ]
      },
      "AccountsResponse": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "accounts"
        ]
      },
      "Beneficiary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "clabeMasked": {
            "type": "string"
          },
          "isInternal": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "alias",
          "clabeMasked",
          "isInternal"
        ]
      },
      "CreateBeneficiaryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "clabe": {
            "type": "string",
            "pattern": "^[0-9]{18}$",
            "description": "Requiere validación adicional de dígito verificador."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "alias",
          "clabe"
        ]
      },
      "BeneficiariesResponse": {
        "type": "object",
        "properties": {
          "beneficiaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Beneficiary"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "beneficiaries"
        ]
      },
      "CreateTransferRequest": {
        "type": "object",
        "properties": {
          "sourceAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "beneficiaryId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
            "description": "Importe MXN decimal exacto como cadena. Debe ser mayor a cero."
          },
          "concept": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "reference": {
            "type": "string",
            "pattern": "^[0-9]{1,7}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "sourceAccountId",
          "amount",
          "concept",
          "reference"
        ],
        "oneOf": [
          {
            "required": [
              "beneficiaryId"
            ],
            "not": {
              "required": [
                "destinationAccountId"
              ]
            }
          },
          {
            "required": [
              "destinationAccountId"
            ],
            "not": {
              "required": [
                "beneficiaryId"
              ]
            }
          }
        ]
      },
      "Transfer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "PENDING_CONFIRMATION",
              "COMPLETED",
              "REJECTED"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "BENEFICIARY",
              "OWN_ACCOUNTS"
            ]
          },
          "sourceAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationAccountMasked": {
            "type": "string"
          },
          "amountCents": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Valor exacto en centavos; no usar float."
          },
          "concept": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "requiresOtp": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "rejectionCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "kind",
          "sourceAccountId",
          "destinationAccountMasked",
          "amountCents",
          "concept",
          "reference",
          "requiresOtp",
          "createdAt",
          "completedAt",
          "rejectionCode"
        ]
      },
      "TransferResponse": {
        "type": "object",
        "properties": {
          "transfer": {
            "$ref": "#/components/schemas/Transfer"
          }
        },
        "additionalProperties": false,
        "required": [
          "transfer"
        ]
      },
      "ConfirmTransferRequest": {
        "type": "object",
        "properties": {
          "otp": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "otp"
        ]
      },
      "Movement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transferId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "signedAmountCents": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "concept": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "transferId",
          "accountId",
          "type",
          "signedAmountCents",
          "createdAt",
          "concept",
          "reference"
        ]
      },
      "MovementsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Movement"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ]
      }
    }
  }
}
