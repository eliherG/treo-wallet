{
  "name": "treo-wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo de Treo Wallet: API, web, mobile y contratos compartidos.",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=12.0.0 <13.0.0"
  },
  "workspaces": [
    "api",
    "web",
    "mobile",
    "packages/shared"
  ],
  "scripts": {
    "dev": "node scripts/unavailable.mjs dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node scripts/unavailable.mjs test",
    "db:migrate": "npm run db:migrate -w @treo/api",
    "db:seed": "node scripts/unavailable.mjs db:seed",
    "db:migrate:test": "npm run db:migrate:test -w @treo/api",
    "db:check": "npm run db:check -w @treo/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
