{
  "name": "@treo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node ../scripts/unavailable.mjs test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx scripts/migrate.ts --test",
    "db:check": "tsx scripts/check-db.ts",
    "test:db": "tsx --test src/database/tests/*.integration.test.ts",
    "start": "tsx src/server.ts",
    "test:http": "tsx --test src/http/tests/*.test.ts",
    "test:auth": "tsx --test src/modules/auth/tests/*.integration.test.ts",
    "test:accounts": "tsx --test src/modules/accounts/tests/*.integration.test.ts",
    "test:beneficiaries": "tsx --test src/modules/beneficiaries/tests/*.test.ts",
    "test:transfers:unit": "tsx --test src/modules/transfers/tests/money.test.ts src/modules/transfers/tests/schemas.test.ts src/modules/transfers/tests/validation.test.ts",
    "test:transfers:integration": "tsx --test src/modules/transfers/tests/t13.integration.test.ts",
    "test:transfers:idempotency:unit": "tsx --test src/modules/transfers/tests/idempotency.test.ts",
    "test:transfers:idempotency:integration": "tsx --test src/modules/transfers/tests/t14.integration.test.ts",
    "test:transfers:atomic": "tsx --test src/modules/transfers/tests/t15.integration.test.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "^18.0.8",
    "express": "5.3.0",
    "jose": "6.2.12",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "5.0.1",
    "typeorm": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.3.1",
    "tsx": "^4.23.15"
  }
}
